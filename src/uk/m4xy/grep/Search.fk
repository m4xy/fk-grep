// A search, as the command line asks for it: the pattern, the files to search, none meaning standard
// input, and how to search them and say what's found.
type Search(
  pattern: String,
  files: List<String>,
  fixedStrings: Boolean,
  ignoreCase: Boolean,
  invert: Boolean,
  wholeWords: Boolean,
  report: Report,
  lineNumbers: Boolean,
  withNames: Boolean,
)
